{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch HRNX Extension (Dev Host)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/hrnx-vscode",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/hrnx-vscode/dist/**/*.js"],
      "preLaunchTask": "npm: build (hrnx-vscode)"
    },
    {
      "name": "Launch Python hrnx-lsp (Debug Server)",
      "type": "debugpy",
      "request": "launch",
      "module": "hrnx.server.lsp",
      "cwd": "${workspaceFolder}/hrnx-core",
      "console": "integratedTerminal"
    }
  ]
}
